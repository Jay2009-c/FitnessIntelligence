<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.example.fitnessanalyzer">

    <!-- Android 14+ System Permissions -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_HEIGHT" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_SPEED" />
    <uses-permission android:name="android.permission.health.READ_ELEVATION_GAINED" />
    <uses-permission android:name="android.permission.health.READ_POWER" />

    <!-- Android 13 and below (Health Connect APK) Permissions -->
    <uses-permission android:name="androidx.health.permission.HeartRate.READ" />
    <uses-permission android:name="androidx.health.permission.Exercise.READ" />
    <uses-permission android:name="androidx.health.permission.RestingHeartRate.READ" />
    <uses-permission android:name="androidx.health.permission.Weight.READ" />
    <uses-permission android:name="androidx.health.permission.Height.READ" />
    <uses-permission android:name="androidx.health.permission.TotalCaloriesBurned.READ" />
    <uses-permission android:name="androidx.health.permission.Distance.READ" />
    <uses-permission android:name="androidx.health.permission.Steps.READ" />
    <uses-permission android:name="androidx.health.permission.Speed.READ" />
    <uses-permission android:name="androidx.health.permission.ElevationGained.READ" />
    <uses-permission android:name="androidx.health.permission.Power.READ" />

    <!-- Gain system visibility to interact with external fitness package application layers -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>

    <application
        android:name=".MainApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Fitness Intelligence"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FitnessIntelligence"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FitnessIntelligence">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Required Platform Privacy screening target for Android Health Connect integration validation -->
        <activity
            android:name=".HealthPrivacyRationaleActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity>

    </application>
</manifest>
